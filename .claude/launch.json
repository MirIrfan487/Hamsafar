{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "server/src/API/Matrimony.Api", "--launch-profile", "http", "--no-launch-profile-arguments"],
      "port": 5080,
      "url": "http://localhost:5080"
    }
  ]
}
