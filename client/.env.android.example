# Copy this file to ".env.android" and build with:  npx vite build --mode android
# The Android app cannot use the Vite proxy, so it needs the full address of the API.
#
# Android emulator -> your PC:      http://10.0.2.2:5080
# Real phone on the same Wi-Fi:     http://<your PC's IPv4 from ipconfig>:5080
# Production:                       https://api.your-domain.com
VITE_API_URL=http://10.0.2.2:5080
