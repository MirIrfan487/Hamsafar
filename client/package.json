{
  "name": "matrimony-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:android": "tsc && vite build --mode android && cap sync android",
    "build:android:release": "tsc && vite build --mode android-release && cap sync android",
    "open:android": "cap open android",
    "icons:android": "capacitor-assets generate --android --iconBackgroundColor #0a1526 --splashBackgroundColor #0a1526 --splashBackgroundColorDark #0a1526",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@microsoft/signalr": "^8.0.7",
    "capacitor-razorpay": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
