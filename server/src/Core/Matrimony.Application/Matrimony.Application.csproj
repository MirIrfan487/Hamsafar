<Project Sdk="Microsoft.NET.Sdk">

  <!-- APPLICATION LAYER
       Business rules (services), DTOs and interfaces.
       Depends only on Domain. It talks to the database through IAppDbContext
       and creates tokens through ITokenService — the real classes live in External. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Matrimony.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Matrimony.Domain\Matrimony.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core base package only (DbSet, Include, ToListAsync). NOT SqlServer. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
  </ItemGroup>

</Project>
