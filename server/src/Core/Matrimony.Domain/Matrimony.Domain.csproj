<Project Sdk="Microsoft.NET.Sdk">

  <!-- DOMAIN LAYER (the centre of the onion)
       Entities, enums and constants. Depends on NO other project.
       The only package is for IdentityUser (base class of AppUser). -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Matrimony.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="9.0.0" />
  </ItemGroup>

</Project>
