<Project Sdk="Microsoft.NET.Sdk">

  <!-- INFRASTRUCTURE LAYER (outer ring)
       Talks to the outside world: JWT tokens now; later photo storage, email/SMS, Razorpay.
       Implements interfaces defined in Application (e.g. ITokenService). -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Matrimony.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Matrimony.Application\Matrimony.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.0.1" />
  </ItemGroup>

</Project>
