<Project Sdk="Microsoft.NET.Sdk">

  <!-- PERSISTENCE LAYER (outer ring)
       Everything about the database: AppDbContext, table configurations,
       migrations and seed data. Implements IAppDbContext from Application. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Matrimony.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Matrimony.Application\Matrimony.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core shared framework: Identity, configuration, options -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
  </ItemGroup>

</Project>
